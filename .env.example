# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Company Information ──────────────────────────────────────────────────────
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=123 Business Street, City, State 12345
COMPANY_PHONE=+1 (555) 123-4567
COMPANY_EMAIL=info@yourcompany.com
COMPANY_WEBSITE=www.yourcompany.com
CURRENCY_SYMBOL=$
DEFAULT_TAX_RATE=0
QUOTE_VALIDITY_DAYS=30

# ─── DeepSeek LLM (optional – enables natural language chat) ─────────────────
# Get your key from: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID found in the Google Sheets URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Sheet range – Row 1 is headers; data starts from row 2.
# Expected columns: A=Name  B=Code  C=Description  D=Unit  E=CostPrice  F=SellingPrice  G=Category
GOOGLE_SHEET_RANGE=Products!A2:G

# Google Service Account credentials (choose ONE option):
#
# Option A – Base64-encoded JSON key (paste entire service account JSON as base64):
GOOGLE_CREDENTIALS_BASE64=

# Option B – Path to the downloaded JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Option C – Individual fields from the JSON key:
# GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail example: use an App Password (not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
